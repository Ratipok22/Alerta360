# Copia este archivo a ".env" si necesitas sobreescribir algun valor por
# defecto (no es obligatorio para correr en local -- el codigo ya trae un
# valor por defecto razonable para cada uno). Nunca se sube a git (ver
# .gitignore en la raiz del repo).
#
# Para el DESPLIEGUE real (Supabase + servidor Docker + Vercel) no se usa
# este archivo -- ver deploy/api.env.example y deploy/README.md, que tienen
# sus propias variables obligatorias (DATABASE_URL, CORS_ORIGINS,
# JWT_SECRET_KEY, OPERADORES_BCRYPT_JSON).

# URL del motor de rutas real (OSRM). Por defecto apunta a localhost:5001
# (ver routing/README.md). Si se despliega con docker-compose, el propio
# compose ya la sobreescribe internamente a "http://osrm:5000".
OSRM_URL=http://localhost:5001

# Clave para firmar los tokens de sesion (login). Esta SI es importante
# generarla real y distinta por entorno -- con el valor por defecto del
# codigo (solo para que no truene si falta) cualquiera podria firmar
# tokens validos. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=cambia_esta_clave_por_una_generada_al_azar

# Opcional en local: si se define, obtener_conexion() (database/database.py)
# usa esta URL de conexion a Postgres en vez de las variables POSTGRES_*
# sueltas (host/puerto/usuario/clave) que ya trae docker/.env.example.
# Solo hace falta si se quiere apuntar el backend local a una base que NO
# sea el contenedor de docker-compose (ej. probar contra Supabase a mano).
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos?sslmode=require

# Lista de origenes permitidos para CORS, separados por coma. Si no se
# define, el codigo usa por defecto solo "http://localhost:5173" (el
# frontend local). Solo hace falta cambiarla para probar el backend desde
# otro origen que no sea ese.
# CORS_ORIGINS=http://localhost:5173

# "production" activa validaciones extra en core/auth.py (exige
# JWT_SECRET_KEY real de 32+ caracteres y habilita SOLO las cuentas de
# OPERADORES_BCRYPT_JSON en vez de las 4 de prueba fijas). Dejar sin
# definir en desarrollo local.
# APP_ENV=production

# Requerido SOLO si APP_ENV=production: JSON con los correos autorizados
# y su hash bcrypt, ver deploy/README.md para como generarlos.
# OPERADORES_BCRYPT_JSON={"correo@dominio.cl":"$2b$12$..."}

# Rutas opcionales para el modelo ML y el historial persistido -- por
# defecto usan carpetas dentro del propio repo (ml/artifacts/ y junto a
# main.py). Solo hace falta cambiarlas en un despliegue con disco separado.
# MODEL_PATH=/model/demand_model.joblib
# HISTORIAL_PATH=/state/historial_acciones.json
