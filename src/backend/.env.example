# Copia este archivo a ".env" si necesitas sobreescribir algun valor por
# defecto (no es obligatorio para correr en local -- el codigo ya trae un
# valor por defecto razonable para cada uno). Nunca se sube a git (ver
# .gitignore en la raiz del repo).

# URL del motor de rutas real (OSRM). Por defecto apunta a localhost:5001
# (ver routing/README.md). Si se despliega con docker-compose, el propio
# compose ya la sobreescribe internamente a "http://osrm:5000".
OSRM_URL=http://localhost:5001

# Clave para firmar los tokens de sesion (login). Esta SI es importante
# generarla real y distinta por entorno -- con el valor por defecto del
# codigo (solo para que no truene si falta) cualquiera podria firmar
# tokens validos. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=cambia_esta_clave_por_una_generada_al_azar
