# Copia este archivo a "deploy/api.env" (sin ".example") en el servidor de
# despliegue. Nunca se sube a git (ver deploy/.gitignore) -- son secretos
# reales de produccion, no valores de desarrollo. Ver deploy/README.md
# para el detalle completo de cada variable y como generarlas.

# Cadena de conexion de Supabase (Postgres), con sslmode=require o
# verify-full. Codifica los caracteres reservados de la contrasena en la
# URI (@, :, /, etc. deben ir con %-encoding si aparecen en la clave).
DATABASE_URL=postgresql://usuario:clave@host.supabase.co:5432/postgres?sslmode=require

# Origenes permitidos para CORS, separados por coma -- la URL publica del
# frontend en Vercel.
CORS_ORIGINS=https://alerta360-zeta.vercel.app

# Secreto para firmar los tokens de sesion. Genera uno real y unico para
# este entorno (nunca reusar el de desarrollo local):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=cambia_esta_clave_por_una_generada_al_azar_de_32_caracteres_o_mas

# JSON con los correos autorizados del catalogo actual (ver core/auth.py)
# y su hash bcrypt. Solo se habilitan las cuentas enumeradas aqui -- en el
# api.env real, usa comillas simples exteriores alrededor del JSON para
# que Docker no interprete los signos de dolar de bcrypt como variables.
# Para generar un hash:
#   python -c "import bcrypt,getpass;print(bcrypt.hashpw(getpass.getpass().encode(),bcrypt.gensalt()).decode())"
OPERADORES_BCRYPT_JSON={"correo@dominio.cl":"$2b$12$reemplazaConElHashReal"}
