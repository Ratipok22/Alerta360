# Copia este archivo a ".env" (sin ".example") en la RAIZ del repo antes
# de correr el backend. Nunca se sube a git (ver .gitignore). Lo carga
# database/database.py (obtener_conexion) para conectarse a Postgres
# desde fuera de Docker -- usa las mismas credenciales que docker/.env,
# pero conectando a localhost:5432 (el puerto que docker-compose expone
# al host), no al nombre de servicio interno "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Alerta360
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_por_la_misma_de_docker/.env
