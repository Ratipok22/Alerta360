# Copia este archivo a ".env" (sin ".example") en esta misma carpeta antes
# de correr docker-compose. ".env" nunca se sube al repo (ver .gitignore
# en la raiz) -- cada quien pone sus propios valores locales; estos son
# solo de desarrollo, no hay datos ni accesos reales de produccion aqui.
POSTGRES_DB=emergency
POSTGRES_USER=emergency
POSTGRES_PASSWORD=cambia_esta_clave_local
